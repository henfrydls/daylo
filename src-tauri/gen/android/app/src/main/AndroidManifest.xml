<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- So the daily reminder arrives at the time it was set for. Android 12 made this
         something to be allowed and Android 14 made it denied by default, which is why
         the settings screen can say so and offer the way to the system's own screen.
         Not USE_EXACT_ALARM, which is granted on sight: Google reserves that one for
         alarm clocks and calendars, and a habit tracker is neither. Without this the
         reminder still arrives, just inexactly.

         Meant to go in 1.5.4, the first build for Google Play, and not before: an update
         that drops this line makes Android remove the exact alarm already pending, so the
         reminder has to be stored where it can be set again from first. It goes together
         with EXACT_ALARMS_DECLARED in src/lib/reminders.ts; scripts/check-exact-alarm.js
         fails in the unit tests, in Build Check (Android) and in release.yml while the two
         disagree. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.activity_tracker"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
