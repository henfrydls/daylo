<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No SCHEDULE_EXACT_ALARM, on purpose, since 1.5.3: the build that goes to Google Play.
         Declaring it means justifying it to Play, and Play's policy asks for inexact alarms
         when a feature does not need the minute. USE_EXACT_ALARM, which is granted on sight,
         is reserved for alarm clocks and calendars, and a habit tracker is neither. Without
         it the daily reminder still arrives, inexactly: around the time it was set for, and
         later out of a deep doze.

         It is meant to come back during the closed test. When it does, put back
             <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
         here and turn on EXACT_ALARMS_DECLARED in src/lib/reminders.ts in the same change.
         That switch is what lets the settings screen offer the phone's "Alarms & reminders"
         screen, which does not list Daylo while this is missing. A unit test reads this file,
         and Build Check (Android) the manifests Gradle merges from it, and both fail while
         the permission and the switch disagree (scripts/check-exact-alarm.js). -->

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.activity_tracker"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
