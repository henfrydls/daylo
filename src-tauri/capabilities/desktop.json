{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "desktop",
  "description": "Desktop-only capabilities (opener, save dialog, updater and relaunch)",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "opener:default",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart"
  ]
}
